{
  "manifest_version": 3,
  "name": "Convenient BOJ - 편한 백준",
  "short_name": "Convenient BOJ",
  "version": "1.0.0",
  "description": "백준 문제 화면에서 코드 작성·실행(C/C++/Python)·제출·채점 결과 확인까지 한 번에.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Convenient BOJ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://wandbox.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.acmicpc.net/problem/*",
        "https://acmicpc.net/problem/*"
      ],
      "js": [
        "vendor/codemirror/codemirror.js",
        "vendor/codemirror/clike.js",
        "vendor/codemirror/python.js",
        "vendor/codemirror/matchbrackets.js",
        "vendor/codemirror/closebrackets.js",
        "shared/defaults.js",
        "content/split.js"
      ],
      "css": [
        "vendor/codemirror/codemirror.css",
        "content/split.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
